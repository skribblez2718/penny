{
  "name": "@penny/sca-service",
  "version": "0.1.0",
  "description": "Local authenticated Unix-socket boundary for SCA broker contracts",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "bin": {
    "penny-sca-service": "./dist/index.js",
    "penny-sca-p03-bootstrap": "./dist/p03-bootstrap-cli.js",
    "penny-sca-job-store": "./dist/job-store-cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "bun scripts/build.mjs",
    "test:build": "node --test scripts/build.test.mjs",
    "format": "prettier --write \"src/**/*.{ts,mjs,mts}\" \"tests/**/*.ts\" vitest.config.ts package.json \"tsconfig*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,mjs,mts}\" \"tests/**/*.ts\" vitest.config.ts package.json \"tsconfig*.json\"",
    "lint": "eslint --no-config-lookup --ext .ts --parser @typescript-eslint/parser --plugin @typescript-eslint --rule '{\"@typescript-eslint/no-explicit-any\":\"error\",\"@typescript-eslint/no-unused-vars\":\"error\",\"no-debugger\":\"error\",\"no-duplicate-imports\":\"error\"}' --max-warnings 0 src tests vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "test:all": "bun run test:build && bun run format:check && bun run lint && bun run typecheck && bun run typecheck:tests && bun run test && bun run build",
    "start": "node dist/index.js",
    "p03-bootstrap": "node dist/p03-bootstrap-cli.js",
    "job-store": "node dist/job-store-cli.js"
  },
  "dependencies": {
    "tree-sitter": "0.21.1",
    "tree-sitter-javascript": "0.23.1",
    "tree-sitter-php": "0.23.11",
    "tree-sitter-typescript": "0.23.2",
    "typebox": "1.3.27",
    "unicode-case-folding": "1.1.1"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "6.0.3",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=24.21.0"
  },
  "exports": {
    ".": "./dist/index.js",
    "./ordinary-runtime": "./dist/ordinary-runtime.js",
    "./ordinary-application-tests": "./dist/ordinary-application-tests.js",
    "./ordinary-rule-learning": "./dist/ordinary-rule-learning.js",
    "./ordinary-application-container": "./dist/ordinary-application-container.js"
  }
}
