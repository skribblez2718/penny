{
  "name": "@penny/sca-service",
  "version": "0.1.0",
  "description": "Local authenticated Unix-socket boundary for SCA broker contracts",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "bin": {
    "penny-sca-service": "./dist/index.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && bun build src/index.ts --outdir dist --target node --format esm --packages external",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" vitest.config.ts package.json \"tsconfig*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" vitest.config.ts package.json \"tsconfig*.json\"",
    "lint": "eslint --no-config-lookup --ext .ts --parser @typescript-eslint/parser --plugin @typescript-eslint --rule '{\"@typescript-eslint/no-explicit-any\":\"error\",\"@typescript-eslint/no-unused-vars\":\"error\",\"no-debugger\":\"error\",\"no-duplicate-imports\":\"error\"}' --max-warnings 0 src tests vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run --config vitest.config.ts",
    "test:all": "bun run format:check && bun run lint && bun run typecheck && bun run typecheck:tests && bun run test && bun run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "6.0.3",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=24.21.0"
  }
}
