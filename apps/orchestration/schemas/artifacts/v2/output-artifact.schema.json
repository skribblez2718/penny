{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:penny:orchestration:artifacts:output-artifact:2",
  "title": "Output artifact lineage metadata v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "phase",
    "branch_id",
    "kind",
    "operation_id",
    "version",
    "producer",
    "media_type",
    "parent_ref",
    "upstream_refs"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "run_id": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "minLength": 1 },
    "branch_id": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "operation_id": { "type": "string", "minLength": 1 },
    "version": { "type": "integer", "minimum": 1 },
    "producer": { "type": "string", "minLength": 1 },
    "media_type": { "type": "string", "minLength": 1 },
    "parent_ref": {
      "oneOf": [{ "$ref": "urn:penny:orchestration:artifacts:artifact-ref:2" }, { "type": "null" }]
    },
    "upstream_refs": {
      "type": "array",
      "items": { "$ref": "urn:penny:orchestration:artifacts:artifact-ref:2" }
    }
  }
}
