{
  "name": "@penny/orchestration",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./source": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "bin": {
    "penny-orchestration": "./dist/cli.js",
    "penny-kb-gate": "./dist/kb-gate-cli.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "typecheck": "node ./node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:unit": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:node-unit": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:runner": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:research-parity": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts tests/research-parity.test.ts",
    "test:integration": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts 'tests/**/*.integration.test.ts'",
    "test:parity": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts tests/research-parity.test.ts",
    "test:all": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts",
    "test:kb-core": "echo 'KB core tests not yet implemented (G7+); skipping'",
    "verify:python-map": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts tests/python-parity-map.test.ts",
    "pending": "node ./node_modules/vitest/vitest.mjs run --config vitest.config.ts --grep pending",
    "smoke:research": "echo 'Smoke: set PENNY_RESEARCH_DEFAULT_MODEL and pipe a start request to dist/cli.js --execute'"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.1",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "5.9.3",
    "vitest": "2.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
