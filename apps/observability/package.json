{
  "name": "@penny/observability",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "bin": {
    "penny-observability": "./dist/server.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "ensure:orchestration": "bun run --cwd ../orchestration build",
    "build:local": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "build": "bun run ensure:orchestration && bun run build:local",
    "typecheck:local": "tsc -p tsconfig.json",
    "typecheck": "bun run typecheck:local",
    "test": "bun run test:unit",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:all": "bun run typecheck && bun run test:unit",
    "verify:runtime-builds": "node -e \"for(const file of ['../orchestration/dist/index.js','dist/server.js'])if(!require('node:fs').existsSync(file))throw new Error('missing runtime build: '+file)\"",
    "start": "bun run verify:runtime-builds && node dist/server.js"
  },
  "dependencies": {
    "@penny/orchestration": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
