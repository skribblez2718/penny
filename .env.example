# Penny Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Required
# ===========================================

# Current project root
PROJECT_ROOT=/home/user/projects/penny

# Assistant name (displayed in status line)
DA_NAME=Penny

# ===========================================
# Pi / Agent Discovery
# ===========================================

# Canonical path to the .pi directory. Used as fallback by discoverAgents()
# when the cwd upward walk fails. The subagent extension appends /agents to
# this path automatically.
PI_DIRECTORY=/home/user/projects/penny/.pi

# Pi package directory (for documentation references)
PI_PACKAGE_DIR=/home/user/.bun/install/global/node_modules/@earendil-works/pi-coding-agent

# ===========================================
# API Keys
# ===========================================

# OpenAI API key — used by the openai provider in ~/.pi/agent/models.json
# Required for gpt-5.5 and other OpenAI models.
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Ollama models run locally and authenticate via `ollama signin`.
# The ollama provider in models.json uses the literal string "ollama" as its API key.
# This key is used by the search extension: web_search and web_fetch call Ollama's
# CLOUD API (https://ollama.com/api/web_search and /api/web_fetch), which requires it.
# Get from: https://ollama.com/settings/keys
OLLAMA_API_KEY=your-api-key-here

# Optional search extension overrides (defaults shown)
# OLLAMA_WEB_SEARCH_BASE_URL=https://ollama.com
# OLLAMA_WEB_SEARCH_TIMEOUT_MS=30000

# ===========================================
# Observability
# ===========================================

# WebSocket server for real-time observability
PI_OBSERVABILITY_URL=ws://localhost:8765/ws

# REST API base URL (used by compaction extension)
PI_OBSERVABILITY_REST_URL=http://localhost:8765

# API key if required by your observability server
PI_OBSERVABILITY_API_KEY=

# Enable/disable observability (default: true)
PI_OBSERVABILITY_ENABLED=true

# Auto-start observability backend on session start (default: true)
PI_OBSERVABILITY_AUTO_START=true

# Max output length for tool results (default: 10000)
PI_OBSERVABILITY_MAX_OUTPUT_LENGTH=10000

# Data directory for SQLite DB
PI_OBSERVABILITY_DATA_DIR=/home/user/.local/share/penny/observability

# Disk use is bounded by in-process SIZE-BASED ROTATION (no age retention, no
# cron, no systemd). When the on-disk file reaches the cap, the oldest rows are
# evicted across ALL tables until live bytes fall back to the floor. Rotation
# runs on server startup and on a periodic interval; it never issues VACUUM.

# Rotation cap — file size that triggers rotation, in GB (default: 5.0)
PI_OBSERVABILITY_DB_SIZE_MAX_GB=5.0

# Rotation floor — live-byte target rotation drains down to, in GB (default: 1.0)
PI_OBSERVABILITY_DB_SIZE_FLOOR_GB=1.0

# Observability server host (default: localhost)
# PI_OBSERVABILITY_HOST=localhost

# Observability server port (default: 8765)
# PI_OBSERVABILITY_PORT=8765

# ===========================================
# Memory System (MemPalace 3.7.1 HTTP hub)
# ===========================================

# Durable memory is optional. "disabled" exposes no memory tools and does not
# affect artifact/checkpoint workflow recovery. Use "hub" only after creating a
# caller-owned supervised-hub config and credential outside the repository.
PENNY_MEMORY_MODE=disabled
PENNY_MEMORY_LOGSTREAM_MODE=disabled

# Hub-mode example (all values are caller supplied; no raw/direct fallback):
# PENNY_MEMORY_MODE=hub
# Writes default to disabled for read-only qualification. Enable only after the
# journaled canary and accepted-write reconciliation gate passes.
# PENNY_MEMORY_WRITE_MODE=disabled
# Advisory logstream access is independently default-off. primary-advisory
# exposes only append/list/wait/ack in the unmarked primary runtime. Stream and
# rooms are trusted configuration, never model routing arguments. With writes
# disabled, only list/wait register.
# PENNY_MEMORY_LOGSTREAM_MODE=primary-advisory
# PENNY_MEMORY_LOGSTREAM_STREAM=project/advisory
# PENNY_MEMORY_LOGSTREAM_ROOMS=status,questions
# PENNY_MEMORY_MCP_ENDPOINT=http://127.0.0.1:8766/mcp
# PENNY_MEMORY_PALACE_ID=penny
# PENNY_MEMORY_DATA_ROOT_ID=local-penny-palace
# PENNY_MEMORY_PRINCIPAL_ID=penny-primary
# PENNY_MEMORY_TRUST_MODE=isolated
# PENNY_MEMORY_ISOLATION_BOUNDARY_ID=penny-local
# PENNY_MEMORY_OWNER_ID=operator
# PENNY_MEMORY_BACKUP_POLICY_REF=memory-backup-v1
# PENNY_MEMORY_MIGRATION_POLICY_REF=memory-migration-v1
# PENNY_MEMORY_RETENTION_POLICY_REF=memory-retention-v1
# PENNY_MEMORY_UNINSTALL_DISPOSITION=preserve
# PENNY_MEMORY_MCP_TOKEN_FILE=/absolute/private/path/to/hub-token
# Alternatively name an environment variable that contains the token:
# PENNY_MEMORY_MCP_TOKEN_ENV=PENNY_MEMORY_HUB_TOKEN

# Every complete model-visible memory/artifact result is independently bounded.
# These optional values may LOWER, never raise, the hard defaults.
# PENNY_TOOL_RESULT_MAX_BYTES=32768
# PENNY_TOOL_RESULT_MAX_CHARACTERS=32768
# PENNY_TOOL_RESULT_MAX_TOKENS=8192

# Track-A workflow dispatch control. Exactly active|paused; absent defaults active
# and any unknown value fails closed. Paused keeps status/exact artifact reads
# available and recovers forward from the unchanged checkpoint after reactivation.
# PENNY_ARTIFACT_DISPATCH_MODE=active

# ===========================================
# Skill Configuration
# ===========================================

# Skill timeout in milliseconds (default: 43200000 = 12 hours)
# PENNY_SKILL_TIMEOUT=43200000

# Agent timeout in milliseconds (default: 1800000 = 30 minutes)
# PENNY_AGENT_TIMEOUT=1800000

# Max skill iterations before error (default: 20)
# PENNY_SKILL_MAX_ITERATIONS=20

# Override skills directory (default: .pi/skills)
# PENNY_SKILLS_DIR=/home/user/projects/penny/.pi/skills

# ===========================================
# Orchestration loop guards — model-judged instead of string-matched
# ===========================================
# APPLIES TO EVERY SKILL, not one. Unset (the default), the engine's loop guards
# compare gap/strategy text by normalized STRING equality: a verifier that merely
# REWORDS the same unresolved issue reads as "progress", so a stalled run keeps
# burning its revision budget instead of escalating. When set, a cheap model judges
# "stalled or progressing?" / "same approach or different?" semantically.
# Any failure falls back to the string comparison, so this can only add catches.
# COST: one extra model call per guard evaluation on every iterating run.
# Format: provider/model-id
# PI_STALL_MODEL=ollama/deepseek-v4-flash:cloud
# PI_STRATEGY_MODEL=ollama/deepseek-v4-flash:cloud

# ===========================================
# Enhance (on-demand prompt enhancement via a trailing ` -i` suffix)
# ===========================================

# End a typed prompt with ` -i` to rewrite it into a world-class, goal-oriented
# prompt before the model acts on it. Prompts without the flag are unchanged.

# Enhance model as provider/model-id (default: the session model)
# PENNY_ENHANCE_MODEL=ollama/deepseek-v4-flash:cloud

# Hard cap on the enhancement call in milliseconds (default: 25000)
# PENNY_ENHANCE_TIMEOUT_MS=25000

# Ceiling on the serialized session transcript handed to the enhancer, in
# characters (default: 3200000). Oldest entries are dropped first.
# PENNY_ENHANCE_CONTEXT_MAX_CHARS=3200000

# ===========================================
# Playwright (Browser Automation)
# ===========================================

# Proxy server for Playwright browser traffic (e.g., http://localhost:8080)
# PLAYWRIGHT_PROXY_SERVER=http://localhost:8080

# Proxy bypass list (comma-separated hosts)
# PLAYWRIGHT_PROXY_BYPASS=localhost,127.0.0.1

# Ignore HTTPS errors (default: false)
# PLAYWRIGHT_IGNORE_HTTPS_ERRORS=false

# Headless mode (default: true)
# PLAYWRIGHT_HEADLESS=true

# ===========================================
# Structured Error Logging
# ===========================================

# Log verbosity level (DEBUG | INFO | WARN | ERROR | CRITICAL)
# default: WARN
PI_LOG_LEVEL=WARN

# Log output format (json | text)
# json = structured JSON lines to stderr
# text = human-readable bracketed format
# default: json
PI_LOG_FORMAT=json
