{
  "name": "pi-skill-extension",
  "version": "0.1.0",
  "description": "Pi extension for durable TypeScript skill orchestration and composition",
  "type": "module",
  "scripts": {
    "lint": "eslint . --ext .ts --max-warnings=0",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "bunx vitest run --config tests/vitest.config.ts",
    "test:unit": "bunx vitest run --config tests/vitest.config.ts",
    "test:integration": "bunx vitest run --config tests/vitest.integration.config.ts",
    "test:registration": "bunx vitest run --config tests/vitest.config.ts tests/unit/knowledge-base-registration.test.ts tests/unit/engine-path.test.ts",
    "test:e2e": "bunx vitest run --config tests/vitest.e2e.config.ts",
    "test:knowledge-base-e2e": "bunx vitest run --config tests/vitest.e2e.config.ts tests/e2e/knowledge-base.e2e.test.ts",
    "test:all": "bun run typecheck && bun run lint && bun run format:check && bun run test:unit && bun run test:integration && bun run test:e2e",
    "test:watch": "bunx vitest --config tests/vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@penny/memory-extension": "workspace:*",
    "@penny/orchestration": "workspace:*"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  }
}
