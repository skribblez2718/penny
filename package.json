{
  "name": "penny",
  "version": "0.1.0",
  "description": "Penny - Personal AI assistant with MemPalace memory system",
  "private": true,
  "type": "module",
  "workspaces": [
    ".pi/extensions/artifacts",
    ".pi/extensions/compaction",
    ".pi/extensions/enhance",
    ".pi/extensions/environment",
    ".pi/extensions/lib",
    ".pi/extensions/memory",
    ".pi/extensions/observability",
    ".pi/extensions/playwright",
    ".pi/extensions/powerpoint",
    ".pi/extensions/questionnaire",
    ".pi/extensions/search",
    ".pi/extensions/skill",
    ".pi/extensions/statusline",
    ".pi/extensions/subagent",
    ".pi/extensions/word",
    ".pi/extensions/youtube",
    "apps/observability",
    "apps/orchestration",
    "apps/platform-memory"
  ],
  "scripts": {
    "lint": "bun run typescript:inventory && bun run typescript:architecture && bun run lint:typescript",
    "lint:typescript": "node scripts/system/checks/typescript-lint.mjs",
    "lint:fix": "node scripts/system/checks/typescript-lint.mjs --fix && bun run typescript:inventory && bun run typescript:architecture",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "typescript:inventory": "node scripts/system/checks/typescript-guard.mjs inventory --root .pi/extensions --root .pi/lib --root apps/observability --root apps/orchestration --root apps/platform-memory --extension-root .pi/extensions --tool-adapter .pi/lib/pi-tool-registration.ts",
    "typescript:architecture": "node scripts/system/checks/typescript-guard.mjs architecture --root .pi/extensions --root .pi/lib --root apps/observability --root apps/orchestration --root apps/platform-memory --extension-root .pi/extensions --tool-adapter .pi/lib/pi-tool-registration.ts",
    "typescript:guard-tests": "node scripts/system/checks/typescript-guard.test.mjs",
    "security:secrets:provision": "sh scripts/security/provision-gitleaks.sh",
    "security:secrets:staged": "sh scripts/security/scan-secrets.sh staged",
    "security:secrets:range": "sh scripts/security/scan-secrets.sh range",
    "test:security:secrets": "sh scripts/security/tests/gitleaks.test.sh",
    "py:lint": "source .venv/bin/activate && flake8 . --config .flake8",
    "py:format": "source .venv/bin/activate && black . --config pyproject.toml",
    "py:format:check": "source .venv/bin/activate && black . --check --config pyproject.toml",
    "py:typecheck": "source .venv/bin/activate && mypy . --config-file pyproject.toml",
    "py:install": "uv venv .venv && uv sync --extra dev",
    "build:observability": "(cd apps/observability && bun run build)",
    "build:orchestration": "(cd apps/orchestration && bun run build)",
    "typecheck:orchestration": "(cd apps/orchestration && bun run typecheck)",
    "typecheck:orchestration-tests": "(cd apps/orchestration && bun run typecheck:tests)",
    "typecheck:orchestration-smoke": "(cd apps/orchestration && bun run typecheck:smoke)",
    "test:orchestration": "(cd apps/orchestration && bun run test)",
    "test:orchestration:integration": "(cd apps/orchestration && bun run test:integration)",
    "test:orchestration:parity": "(cd apps/orchestration && bun run test:parity)",
    "test:kb-model-smoke": "(cd apps/orchestration && bun run test:kb-model-smoke)",
    "test": "bun run test:unit",
    "test:typescript": "bun run typescript:inventory && bun run typescript:architecture && bun run test:lib && node scripts/system/checks/typescript-tests.mjs",
    "test:lib": "vitest run --config .pi/lib/tests/vitest.config.ts",
    "test:unit": "set -e; bun run test:lib; for dir in .pi/extensions/*/; do (cd \"$dir\" && bun run test:unit); done; (cd apps/observability && bun run test:unit); (cd apps/orchestration && bun run test:unit); (cd apps/platform-memory && bun run test:unit)",
    "test:integration": "set -e; for dir in .pi/extensions/*/; do if grep -q '\"test:integration\"' \"$dir/package.json\"; then (cd \"$dir\" && bun run test:integration); fi; done; (cd apps/platform-memory && bun run test:integration && bun run test:clean-machine)",
    "test:python": ".venv/bin/python -m pytest scripts/system/memory/tests scripts/system/tests -p no:cacheprovider --tb=short -q",
    "test:all": "bun run typecheck && bun run lint && bun run format:check && bun run py:typecheck && bun run py:lint && bun run py:format:check && bun run test:typescript && bun run test:python",
    "typecheck:extensions": "set -e; for dir in .pi/extensions/*/; do (cd \"$dir\" && bun run typecheck); done",
    "typecheck:lib": "tsc -p .pi/lib/tsconfig.json",
    "typecheck:all": "bun run typecheck:extensions && bun run typecheck:orchestration && (cd apps/observability && bun run typecheck) && (cd apps/platform-memory && bun run typecheck) && bun run typecheck:lib",
    "typecheck": "bun run typescript:inventory && bun run typescript:architecture && bun run typecheck:all"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@eslint/js": "^9.0.0",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.0.0",
    "typebox": "1.3.7",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^2.1.0",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
